{
  "name": "@loft/sdk",
  "version": "0.1.0",
  "description": "Browser SDK for Loft-hosted apps: identity, AI chat, document DB, realtime channels, and uploads.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "sideEffects": false,
  "main": "./dist/loft.mjs",
  "module": "./dist/loft.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/loft.js",
  "jsdelivr": "./dist/loft.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/loft.mjs",
      "default": "./dist/loft.mjs"
    }
  },
  "files": ["dist"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larsakerlund/loft-js.git"
  },
  "keywords": ["loft", "sdk", "browser", "hosting"],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/loft.mjs && esbuild src/index.ts --bundle --format=iife --outfile=dist/loft.js && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "esbuild src/index.ts --bundle --format=esm --outfile=dist/loft.mjs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
