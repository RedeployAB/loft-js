{
  "name": "loft-js",
  "version": "0.1.0",
  "description": "Browser SDK for Loft-hosted apps: identity, AI chat, document DB, realtime channels, and uploads.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "sideEffects": false,
  "main": "./dist/loft.mjs",
  "module": "./dist/loft.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/loft.js",
  "jsdelivr": "./dist/loft.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/loft.mjs",
      "default": "./dist/loft.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larsakerlund/loft-js.git"
  },
  "homepage": "https://github.com/larsakerlund/loft-js#readme",
  "bugs": {
    "url": "https://github.com/larsakerlund/loft-js/issues"
  },
  "keywords": [
    "loft",
    "sdk",
    "browser",
    "hosting"
  ],
  "scripts": {
    "build:esm": "esbuild src/index.ts --bundle --format=esm --target=es2020 --sourcemap --outfile=dist/loft.mjs",
    "build:cdn": "esbuild src/global.ts --bundle --format=iife --target=es2020 --minify --sourcemap --outfile=dist/loft.js",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "build": "pnpm run build:esm && pnpm run build:cdn && pnpm run build:types",
    "dev": "esbuild src/index.ts --bundle --format=esm --target=es2020 --outfile=dist/loft.mjs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eventsource-parser": "^3.1.0",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.9"
  }
}
